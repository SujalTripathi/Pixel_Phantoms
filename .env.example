# Database Configuration
# Replace with your PostgreSQL database credentials
DB_USER=your_database_username
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name

# JWT Configuration
# Generate a strong random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=15m

# Email Configuration (Gmail SMTP)
# For Gmail: Use App Password (not your regular password)
# Enable 2FA and create App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=your_email@gmail.com

# ⚠️ SECURITY NOTICE:
# 1. NEVER commit the actual .env file to version control
# 2. Copy this file to .env and fill in your actual credentials
# 3. Rotate all secrets immediately if accidentally exposed
# 4. Use strong, unique passwords for each service
# 5. For production, use environment variables or secret management services
